
# -----------------------------------------
# DATABASE CONNECTION (PostGIS / PostgreSQL)
PIPELINE_HOST_IP=host.docker.internal
PIPELINE_HOST_PORT= {exposed_port}
PIPELINE_HOST_NAME={db_name}
PIPELINE_HOST_USER={db_username}
PIPELINE_HOST_PASSWORD={db_password}

# -----------------------------------------
# SCHEMA NAMES (used for reading/writing)
PIPELINE_BRONZE_SCHEMA="Bronze"
PIPELINE_SILVER_SCHEMA="Silver"
PIPELINE_GOLD_SCHEMA="Gold"

# -----------------------------------------
# OPTIONAL: Enable Spark mode (must be 'true' or blank)
USE_Spark=true

# -----------------------------------------
# NOTIFICATIONS (optional if you add Slack/email/etc.)
NOTIFY_EMAIL={samplemail@gmai.com}
NOTIFY_ON_FAILURE=true

# -----------------------------------------
# RETRY SETTINGS (optional)
RETRY_COUNT=3
RETRY_DELAY_SECONDS=60

# Network Configuration (incase of bind issues that may arise ,done to supress warnings)
SPARK_DRIVER_HOST={public ip}
SPARK_DRIVER_BIND_ADDRESS={public ip}

# Spark-Sedona Packages
SPARK_JARS_PACKAGES=org.apache.sedona:sedona-spark-shaded-3.5_2.12:1.7.2,org.datasyslab:geotools-wrapper:1.5.1-28.2,org.postgresql:postgresql:42.6.0

# Memory Configuration (allocating spark memory can be adjusted)
SPARK_EXECUTOR_MEMORY=4g
SPARK_DRIVER_MEMORY=4g

#  Spark Settings
SPARK_SERIALIZER=org.apache.spark.serializer.KryoSerializer
SPARK_LEGACY_UDF=true
#can be ignored was set to resolve and enforce linux dynamic ip on restart 
AIRFLOW_CONN_PIPELINE_DB=postgresql://postgres:6590@172.17.0.1:5433/erits

PARQUET_FOLDER=/opt/airflow/data
